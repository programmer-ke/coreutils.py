#!/usr/bin/env python
import argparse
import sys

MAX_WIDTH = 16


def format_row(offset, line, canonical_display=False):
    if canonical_display:
        wordsize, offset_fmt, word_fmt = 1, "08x", "02x"
    else:
        wordsize, offset_fmt, word_fmt = 2, "07x", "04x"

    displayed_offset = format(offset, offset_fmt)
    words = [line[i : i + wordsize] for i in range(0, len(line), wordsize)]
    words = [int.from_bytes(w, sys.byteorder) for w in words]
    words = [format(w, word_fmt) for w in words]
    if canonical_display:
        # ensure we have 16 values to match expected format
        words = words + ["  " for _ in range(MAX_WIDTH - len(words))]
        hex_left = " ".join(w for w in words[0:8])
        hex_right = " ".join(w for w in words[8:])
        ascii_chars = "".join([chr(c) if 0x20 <= c <= 0x7E else "." for c in line])
        ascii_col = f"|{ascii_chars}|"
        formatted = f"{displayed_offset}  {hex_left}  {hex_right}  {ascii_col}"
    else:
        row = " ".join(words)
        row = format(row, "<39")
        formatted = f"{displayed_offset} {row}"

    return formatted


def process(offset, row, args):
    return format_row(offset, row, args.C)


def main(args):
    input_length = 0
    while True:
        content = sys.stdin.buffer.read(MAX_WIDTH)
        if not content:
            break
        output = process(input_length, content, args)
        print(output)
        input_length += len(content)
    if input_length:
        print(format(input_length, "08x" if args.C else "07x"))


if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        prog="hexdump", description="Display input content in hexadecimal"
    )
    parser.add_argument("-C", action="store_true", help="Canonical display")
    args = parser.parse_args()
    main(args)
